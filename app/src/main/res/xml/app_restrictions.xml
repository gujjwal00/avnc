<!--
  This is a static mirror of com.gaurav.avnc.util.Restrictions.ALL.
  It is consumed by EMM consoles to present manageable settings.
  Keep it in sync with that list (config, not logic).
-->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Appearance -->
    <restriction
        android:key="emm_theme"
        android:title="@string/emm_theme_title"
        android:restrictionType="choice"
        android:entries="@array/theme_entries"
        android:entryValues="@array/theme_values" />

    <restriction
        android:key="emm_bell"
        android:title="@string/emm_bell_title"
        android:restrictionType="bool" />

    <restriction
        android:key="emm_sort_server_list"
        android:title="@string/emm_sort_server_list_title"
        android:restrictionType="bool" />

    <restriction
        android:key="emm_prefer_advanced_editor"
        android:title="@string/emm_prefer_advanced_editor_title"
        android:restrictionType="bool" />

    <!-- Viewer -->
    <restriction
        android:key="emm_screen_orientation"
        android:title="@string/emm_screen_orientation_title"
        android:restrictionType="choice"
        android:entries="@array/orientation_entries"
        android:entryValues="@array/orientation_values" />

    <restriction
        android:key="emm_keep_screen_on"
        android:title="@string/emm_keep_screen_on_title"
        android:restrictionType="bool" />

    <restriction
        android:key="emm_fullscreen"
        android:title="@string/emm_fullscreen_title"
        android:restrictionType="bool" />

    <restriction
        android:key="emm_draw_behind_cutout"
        android:title="@string/emm_draw_behind_cutout_title"
