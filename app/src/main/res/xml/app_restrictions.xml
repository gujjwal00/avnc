    <restriction
        android:key="emm_pause_fb_background"
        android:title="@string/emm_pause_fb_background_title"
        android:restrictionType="bool" />

    <!-- Zoom min bounds: 10 to 100 -->
    <restriction
        android:key="emm_zoom_min"
        android:title="@string/emm_zoom_min_title"
        android:restrictionType="integer"
        android:defaultValue="50"
        android:description="@string/emm_zoom_min_desc" />

    <!-- Zoom max bounds: 100 to 1000 -->
    <restriction
        android:key="emm_zoom_max"
        android:title="@string/emm_zoom_max_title"
        android:restrictionType="integer"
        android:defaultValue="500"
        android:description="@string/emm_zoom_max_desc" />

    <restriction
        android:key="emm_per_orientation_zoom"
