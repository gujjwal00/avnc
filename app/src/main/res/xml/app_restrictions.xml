        android:key="emm_gesture_swipe_sensitivity"
        android:title="@string/emm_gesture_swipe_sensitivity_title"
        android:restrictionType="integer"
        android:defaultValue="10"
        android:description="@string/emm_gesture_swipe_sensitivity_desc" />

    <restriction
        android:key="emm_invert_scrolling"
        android:title="@string/emm_invert_scrolling_title"
